# Never commit real tokens or keys. Copy this file to .env on the host.
RWI_DISCORD_TOKEN=
RWI_DISCORD_APPLICATION_ID=
RWI_DISCORD_GUILD_ID=
RWI_OWNER_USER_ID=
OPENAI_API_KEY=

# Database
RWI_DB_NAME=rwi
RWI_DB_USER=rwi
RWI_DB_PASSWORD=replace-with-a-long-random-password
RWI_DATABASE_URL=postgresql+asyncpg://rwi:replace-with-a-long-random-password@db:5432/rwi

# Models and cost controls
RWI_MODEL_NORMAL=gpt-5.6-terra
RWI_MODEL_COMPLEX=gpt-5.6
RWI_MODEL_ECONOMY=gpt-5.6-luna
RWI_EMBEDDING_MODEL=text-embedding-3-small
RWI_OPENAI_HARD_BUDGET_USD=25.00
RWI_MEMBER_RESERVE_USD=5.00
RWI_WEB_SEARCH_ENABLED=true
RWI_OFFICIAL_SEARCH_DOMAINS=ubisoft.com
RWI_OFFICIAL_SEARCH_URLS=https://trello.com/b/F2RU9ia9/the-division-2-known-issues
RWI_COMMUNITY_SEARCH_DOMAINS=wikipedia.org,thedivision.fandom.com,reddit.com,gaming.stackexchange.com,gamefaqs.gamespot.com,steamcommunity.com,thedivisionforums.com,prototrack.gg,siriusarc7.github.io,github.com,raw.githubusercontent.com,rubenalamina.mx,youtube.com,youtu.be
RWI_CURRENT_GAME_VERSION=Y8S3 Red Horizon
RWI_CURRENT_GAME_VERSION_STARTED_ON=2026-08-27
RWI_COMMUNITY_LOADOUT_INDEXING_ENABLED=true

# Runtime
RWI_LOG_LEVEL=INFO
RWI_RUNTIME_DIR=/data/runtime
RWI_AUTO_BOOTSTRAP_SERVER=false
RWI_SYNC_COMMANDS=true

# Privacy-preserving spam escalation: delete/warn, timeout, then kick; never ban
RWI_SPAM_DETECTION_ENABLED=true
RWI_SPAM_REPEATED_MESSAGES=3
RWI_SPAM_BURST_MESSAGES=7
RWI_SPAM_SEVERE_MESSAGES=12
RWI_SPAM_WINDOW_SECONDS=10
RWI_SPAM_INCIDENT_COOLDOWN_SECONDS=4
RWI_SPAM_HISTORY_HOURS=24
RWI_SPAM_TIMEOUT_MINUTES=10

