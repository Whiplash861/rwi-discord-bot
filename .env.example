# Never commit real tokens or keys. Copy this file to .env on the host.
RWI_DISCORD_TOKEN=
RWI_DISCORD_APPLICATION_ID=
RWI_DISCORD_GUILD_ID=
RWI_OWNER_USER_ID=
OPENAI_API_KEY=

# Database
RWI_DB_NAME=rwi
RWI_DB_USER=rwi
RWI_DB_PASSWORD=replace-with-a-long-random-password
RWI_DATABASE_URL=postgresql+asyncpg://rwi:replace-with-a-long-random-password@db:5432/rwi

# Models and cost controls
RWI_MODEL_NORMAL=gpt-5.6-terra
RWI_MODEL_COMPLEX=gpt-5.6
RWI_MODEL_ECONOMY=gpt-5.6-luna
RWI_EMBEDDING_MODEL=text-embedding-3-small
RWI_OPENAI_HARD_BUDGET_USD=25.00
RWI_MEMBER_RESERVE_USD=5.00
RWI_WEB_SEARCH_ENABLED=true
RWI_OFFICIAL_SEARCH_DOMAINS=ubisoft.com
RWI_OFFICIAL_SEARCH_URLS=https://trello.com/b/F2RU9ia9/the-division-2-known-issues
RWI_COMMUNITY_SEARCH_DOMAINS=wikipedia.org,thedivision.fandom.com,reddit.com,gaming.stackexchange.com,gamefaqs.gamespot.com,steamcommunity.com,thedivisionforums.com,prototrack.gg,when.shd.support,divisiontimers.com,thedivisiondispatch.com,siriusarc7.github.io,github.com,raw.githubusercontent.com,rubenalamina.mx,youtube.com,youtu.be,x.com,pbs.twimg.com,shdmanual.com,discordbotlist.com
RWI_CURRENT_GAME_VERSION=Y8S3 Red Horizon
RWI_CURRENT_GAME_VERSION_STARTED_ON=2026-08-27
RWI_COMMUNITY_LOADOUT_INDEXING_ENABLED=true

# Privacy-bounded gameplay video inspection. Raw uploads are never retained.
RWI_VIDEO_INSPECTION_ENABLED=true
RWI_VIDEO_MAX_DURATION_SECONDS=30
RWI_VIDEO_MAX_BYTES=50000000
RWI_VIDEO_SAMPLE_FRAMES=12
RWI_FFMPEG_BINARY=ffmpeg
RWI_FFPROBE_BINARY=ffprobe

# Guarded game-update autonomy. Community findings are staged for review.
RWI_AUTONOMOUS_RESEARCH_ENABLED=true
RWI_AUTONOMOUS_RESEARCH_INTERVAL_HOURS=6
RWI_AUTONOMOUS_FULL_SWEEP_HOURS=24
RWI_AUTONOMOUS_MAX_FINDINGS_PER_RUN=20
RWI_AUTONOMOUS_AUTO_PROMOTE_OFFICIAL=true

# Read-only live rotation channels. Exact community-only values remain confidence gated.
RWI_ROTATION_UPDATES_ENABLED=true
RWI_ROTATION_REFRESH_MINUTES=60
RWI_ROTATION_WEB_REFRESH_HOURS=6
RWI_ROTATION_ESCALATION_URL=https://hi-dep.github.io/division2/data/event/index.json
RWI_ROTATION_CALENDAR_URL=https://when.shd.support/api/v1/calendar/

# Runtime
RWI_LOG_LEVEL=INFO
RWI_RUNTIME_DIR=/data/runtime
RWI_AUTO_BOOTSTRAP_SERVER=false
RWI_SYNC_COMMANDS=true

# Privacy-preserving spam escalation: delete/warn, timeout, then kick; never ban
RWI_SPAM_DETECTION_ENABLED=true
RWI_SPAM_REPEATED_MESSAGES=3
RWI_SPAM_BURST_MESSAGES=7
RWI_SPAM_SEVERE_MESSAGES=12
RWI_SPAM_WINDOW_SECONDS=10
RWI_SPAM_INCIDENT_COOLDOWN_SECONDS=4
RWI_SPAM_HISTORY_HOURS=24
RWI_SPAM_TIMEOUT_MINUTES=10

